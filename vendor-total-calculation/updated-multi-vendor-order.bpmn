<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0hpp5ul" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="updated-vendor-order" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="StartEvent_1" name="Order received">
      <bpmn:outgoing>Flow_17pbsod</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_17pbsod" sourceRef="StartEvent_1" targetRef="Activity_0oj6izn" />
    <bpmn:endEvent id="Event_0jz5ffr" name="end">
      <bpmn:incoming>Flow_0u4cube</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0ywke27" sourceRef="Activity_0oj6izn" targetRef="Activity_0ezk3p3" />
    <bpmn:subProcess id="Activity_0oj6izn" name="Calculate Total">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=0" target="shippingCost" />
          <zeebe:input source="=0" target="total" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17pbsod</bpmn:incoming>
      <bpmn:outgoing>Flow_0ywke27</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=order.items" inputElement="item" outputCollection="processedItems" outputElement="={ shipping: shippingCost, itemTotal: total }" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Event_18tazc0" name="start">
        <bpmn:outgoing>Flow_084lysh</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_084lysh" sourceRef="Event_18tazc0" targetRef="Gateway_1p7grdv" />
      <bpmn:endEvent id="Event_0wbc1ni">
        <bpmn:incoming>Flow_0u1xjch</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0u1xjch" sourceRef="Activity_0v8lav2" targetRef="Event_0wbc1ni" />
      <bpmn:businessRuleTask id="Activity_0v8lav2" name="get shipping cost">
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="Decision_1a" resultVariable="shippingCost" />
          <zeebe:ioMapping>
            <zeebe:output source="=(item.quantity * item.price) + shippingCost" target="total" />
            <zeebe:output source="=shippingCost" target="shippingCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1inh9cs</bpmn:incoming>
        <bpmn:outgoing>Flow_0u1xjch</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Gateway_1p7grdv" name="Validate price ?">
        <bpmn:incoming>Flow_084lysh</bpmn:incoming>
        <bpmn:outgoing>Flow_1inh9cs</bpmn:outgoing>
        <bpmn:outgoing>Flow_1oos1vp</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1inh9cs" name="Valid" sourceRef="Gateway_1p7grdv" targetRef="Activity_0v8lav2">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=item.price&gt;0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1oos1vp" name="Invalid" sourceRef="Gateway_1p7grdv" targetRef="Event_18p5krg">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=item.price&lt;=0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="Event_18p5krg">
        <bpmn:incoming>Flow_1oos1vp</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1cwe88e" errorRef="Error_0z3vg67" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_0u4cube" sourceRef="Activity_0ezk3p3" targetRef="Event_0jz5ffr" />
    <bpmn:scriptTask id="Activity_0ezk3p3" name="Grand Total">
      <bpmn:extensionElements>
        <zeebe:script expression="=sum(processedItems.itemTotal)" resultVariable="grandTotal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ywke27</bpmn:incoming>
      <bpmn:outgoing>Flow_0u4cube</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:boundaryEvent id="Event_0d65eup" attachedToRef="Activity_0oj6izn">
      <bpmn:outgoing>Flow_1yz3dwo</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0aav9sa" errorRef="Error_0z3vg67" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1yz3dwo" sourceRef="Event_0d65eup" targetRef="Activity_1oc59hz" />
    <bpmn:endEvent id="Event_09n4y5n">
      <bpmn:incoming>Flow_0lhxcgl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0lhxcgl" sourceRef="Activity_1oc59hz" targetRef="Event_09n4y5n" />
    <bpmn:userTask id="Activity_1oc59hz" name="Raise usertask">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="vendor-price" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yz3dwo</bpmn:incoming>
      <bpmn:outgoing>Flow_0lhxcgl</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:error id="Error_0z3vg67" name="invalid price" errorCode="invalid_price" />
